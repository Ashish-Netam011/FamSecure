[TEMPLATE]
# Optional: If provided, AI explanations use live Gemini. Otherwise, built-in deterministic fallback is used.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model override for the Gemini adapter (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: MongoDB connection string. If provided, all incidents/farms persist
# to MongoDB (write-behind, debounced ~800ms) and hydrate on boot. If omitted
# or unreachable, the app runs on the in-memory seed store with background retries.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.hostname.mongodb.net/DATABASE_NAME
